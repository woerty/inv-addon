# Copy to .env and fill in. Used for local (native) development.

# SQLite for local dev (prod uses Postgres via the HA addon).
DATABASE_URL=sqlite+aiosqlite:///./dev.db
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ENVIRONMENT=development

# Picnic credentials for local dev. After filling these in, run once:
#   python -m app.services.picnic.setup
# It performs the interactive 2FA login and writes the auth token to
# PICNIC_TOKEN_PATH. The running backend then reuses that token.
PICNIC_MAIL=
PICNIC_PASSWORD=
PICNIC_COUNTRY_CODE=DE
# Local token cache path (prod defaults to /data/picnic_token.json, which is
# not writable on a dev host, so we override it here).
PICNIC_TOKEN_PATH=./.picnic_token.json
